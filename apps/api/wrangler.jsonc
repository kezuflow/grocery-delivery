{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carbon-food-delivery-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carbon-food-delivery-development",
      "database_id": "7c4d107e-87dc-43ed-9ea2-52f0435aa9aa",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "carbon-food-delivery-media-development" },
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "APP_ENV": "development",
    "API_PUBLIC_ORIGIN": "http://localhost:8787",
    "AUTH_MODE": "persistent-session",
    "CORS_ORIGINS": "http://localhost:3000",
    "VERSION": "0.0.0-dev",
    "DELIVERY_FEE_CENTAVOS": "0",
    "PAYMENT_PROVIDER": "fake",
    "DELIVERY_MEDIA_RETENTION_DAYS": "30",
    "OPERATIONAL_ALERT_PENDING_COUNT": "10",
    "OPERATIONAL_ALERT_PENDING_AGE_SECONDS": "900",
    "OPERATIONAL_ALERT_DEAD_LETTERED_COUNT": "1",
    "OPERATIONAL_ALERT_FAILED_DELIVERY_COUNT": "1",
    "OPERATIONAL_ALERT_OPEN_SHORTAGE_COUNT": "1",
    "OPERATIONAL_ALERT_EXCEPTIONAL_MANIFEST_COUNT": "1",
  },
  "env": {
    "staging": {
      "name": "carbon-food-delivery-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "carbon-food-delivery-staging",
          "database_id": "05a1e958-5e7d-451b-9cc3-dfab99778900",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "MEDIA_BUCKET", "bucket_name": "carbon-food-delivery-media-staging" },
      ],
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "APP_ENV": "staging",
        "VERSION": "0.0.0-staging",
        "API_PUBLIC_ORIGIN": "https://api-staging.getscenepass.com",
        "AUTH_MODE": "better-auth",
        "ADMIN_BOOTSTRAP_EMAILS": "ilyreggie+carbon-admin@gmail.com",
        "BETTER_AUTH_URL": "https://api-staging.getscenepass.com",
        "CORS_ORIGINS": "https://app-staging.getscenepass.com",
        "DELIVERY_FEE_CENTAVOS": "990",
        "DELIVERY_SERVICE_POSTAL_CODES": "1000,1100,1200",
        "PAYMENT_PROVIDER": "paymongo",
        "EMAIL_FROM": "no-reply@getscenepass.com",
        "DELIVERY_MEDIA_RETENTION_DAYS": "30",
        "OPERATIONAL_ALERT_PENDING_COUNT": "10",
        "OPERATIONAL_ALERT_PENDING_AGE_SECONDS": "900",
        "OPERATIONAL_ALERT_DEAD_LETTERED_COUNT": "1",
        "OPERATIONAL_ALERT_FAILED_DELIVERY_COUNT": "1",
        "OPERATIONAL_ALERT_OPEN_SHORTAGE_COUNT": "1",
        "OPERATIONAL_ALERT_EXCEPTIONAL_MANIFEST_COUNT": "1",
      },
    },
    "production": {
      "name": "carbon-food-delivery-api-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "carbon-food-delivery-production",
          "database_id": "8472f405-c722-46e0-ba96-cfec387f283e",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "MEDIA_BUCKET", "bucket_name": "carbon-food-delivery-media-production" },
      ],
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "APP_ENV": "production",
        "VERSION": "0.0.0-production",
        "API_PUBLIC_ORIGIN": "https://api.getscenepass.com",
        "AUTH_MODE": "better-auth",
        "ADMIN_BOOTSTRAP_EMAILS": "no-reply@getscenepass.com",
        "BETTER_AUTH_URL": "https://api.getscenepass.com",
        "CORS_ORIGINS": "https://app.getscenepass.com",
        "DELIVERY_FEE_CENTAVOS": "990",
        "DELIVERY_SERVICE_POSTAL_CODES": "1000,1100,1200",
        "PAYMENT_PROVIDER": "paymongo",
        "EMAIL_FROM": "no-reply@getscenepass.com",
        "DELIVERY_MEDIA_RETENTION_DAYS": "30",
        "OPERATIONAL_ALERT_PENDING_COUNT": "10",
        "OPERATIONAL_ALERT_PENDING_AGE_SECONDS": "900",
        "OPERATIONAL_ALERT_DEAD_LETTERED_COUNT": "1",
        "OPERATIONAL_ALERT_FAILED_DELIVERY_COUNT": "1",
        "OPERATIONAL_ALERT_OPEN_SHORTAGE_COUNT": "1",
        "OPERATIONAL_ALERT_EXCEPTIONAL_MANIFEST_COUNT": "1",
      },
    },
  },
}
