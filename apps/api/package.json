{
  "name": "@carbon/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:development": "wrangler d1 migrations apply DB --remote",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:staging": "wrangler deploy --env staging --domains api-staging.getscenepass.com",
    "deploy:production": "wrangler deploy --env production --domains api.getscenepass.com",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint src",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run src/app.test.ts src/runtime.test.ts src/event-processors.test.ts --pool=threads --poolOptions.threads.singleThread",
    "test:integration": "vitest run src/orders.integration.test.ts --pool=forks --poolOptions.forks.singleFork && vitest run src/better-auth.integration.test.ts --pool=forks --poolOptions.forks.singleFork",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260818.1",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "@carbon/application": "workspace:*",
    "@carbon/auth": "workspace:*",
    "@carbon/billing": "workspace:*",
    "@carbon/config": "workspace:*",
    "@carbon/contracts": "workspace:*",
    "@carbon/db": "workspace:*",
    "@carbon/domain": "workspace:*",
    "@carbon/observability": "workspace:*",
    "@carbon/notifications": "workspace:*",
    "@carbon/storage": "workspace:*",
    "better-auth": "1.7.1",
    "hono": "4.13.2"
  }
}
