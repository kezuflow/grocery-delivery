{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carbon-food-delivery-workflows",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workflows": [
    {
      "name": "weekly-operations",
      "binding": "WEEKLY_OPERATIONS",
      "class_name": "WeeklyOperationsWorkflow",
    },
  ],
  "env": {
    "staging": {
      "name": "carbon-food-delivery-workflows-staging",
      "workflows": [
        {
          "name": "weekly-operations",
          "binding": "WEEKLY_OPERATIONS",
          "class_name": "WeeklyOperationsWorkflow",
        },
      ],
    },
    "production": {
      "name": "carbon-food-delivery-workflows-production",
      "workflows": [
        {
          "name": "weekly-operations",
          "binding": "WEEKLY_OPERATIONS",
          "class_name": "WeeklyOperationsWorkflow",
        },
      ],
    },
  },
}
